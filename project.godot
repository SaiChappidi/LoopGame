; LOOP — modular, local-first game platform
config_version=5

[application]
config/name="LOOP — One more game"
config/version="0.3.0"
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=480
window/size/viewport_height=900
window/size/window_width_override=480
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.039,0.047,0.067,1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true
